# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Values are validated by src/lib/env.ts at startup — a missing required var
# fails the build loudly rather than deploying half-configured.
# ---------------------------------------------------------------------------

# Public site origin. No trailing slash. Used for canonical URLs, hreflang,
# sitemap, robots and OpenGraph image resolution.
NEXT_PUBLIC_SITE_URL=https://petrosyanserg.vercel.app

# Resend API key for the contact form route handler.
# Get one at https://resend.com/api-keys — server-only, never NEXT_PUBLIC_.
# Optional: without it the contact form degrades to the direct-email fallback.
RESEND_API_KEY=

# Verified sender and destination for contact form messages.
CONTACT_FROM_EMAIL=portfolio@example.com
CONTACT_TO_EMAIL=petrosyanserg33@gmail.com
