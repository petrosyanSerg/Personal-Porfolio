{
  "name": "petrosyanserg-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal engineering site for Sergey Petrosyan — Next.js, TypeScript, SCSS, Three.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "portraits": "node scripts/extract-theme-portraits.mjs",
    "portraits:check": "node scripts/extract-theme-portraits.mjs --check",
    "validate": "npm run typecheck && npm run lint && npm run lint:styles && npm run test",
    "validate:full": "npm run validate && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.65.0",
    "resend": "^6.2.0",
    "three": "^0.185.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
